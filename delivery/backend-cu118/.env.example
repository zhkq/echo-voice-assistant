# ECHO 能力后端（**老卡 / cu118**）—— 环境变量模板
#
# 用法：cp .env.example .env  然后只需要动两处：ECHO_JWT_SECRET（必填）与卷路径（不对才改）。
# ⚠️ .env 里有密钥：**别提交到 git、别转发**。（本包不会带上 .env，只带这个模板。）
#
# 变量分两类，别搞混：
#   [宿主] compose 自己用（镜像 tag、挂哪个宿主目录、探针 scheme）—— **不进容器**
#   [容器] 传进容器的服务端运行时配置 —— server/settings.py 真的读它们
#
# ---------------------------------------------------------------------------
# [宿主] 镜像与卷路径
# ---------------------------------------------------------------------------
# 镜像 tag。内网 registry 就写成 <registry>/echo-backend:0.1.0-cu118。
# ⚠️ 必须与本地实际有的那个 tag 一字不差，否则 compose 会以为"没有镜像"而转去现场构建；
#    也**别**把 cu126 的镜像改个 tag 拿来用 —— 那个 torch 里没有这块卡的架构。
ECHO_IMAGE=echo-backend:0.1.0-cu118

# 模型卷（只读挂进容器）。本变体**只需要 SenseVoice**，目录布局见 先读我.md §4。
# ⚠️ 路径写错时 Docker **不会报错**，而是自己建一个空目录 —— 症状是起来之后
#    转写一路 model_failed。摆完一定 `ls` 一下（先读我.md §4 末尾有自检命令）。
ECHO_HOST_MODELS_DIR=/srv/echo/models

# 临时卷（丢了没关系）与状态卷（**耐久**：鉴权库，丢了所有客户端要重新配对）
ECHO_HOST_TMP_DIR=/srv/echo/tmp
ECHO_HOST_STATE_DIR=/srv/echo/state

# ModelScope 的可写缓存卷（SenseVoice 的 VAD 模型 `fsmn-vad` 是按模型名现拉的；根文件系统
# 只读，没这个卷就会 `[Errno 30] Read-only file system` → **每个 /v1/asr 都 model_failed，
# 而 /v1/health 照样绿**）。属于"可以丢"的卷：丢了下次加载模型会重下（约 1.7 MB）。
ECHO_HOST_CACHE_DIR=/srv/echo/cache

# 健康探针用的 scheme：容器里启用 TLS 时改成 https，否则容器会一直显示 unhealthy
# （而服务其实是好的）。默认明文 http —— 本包默认不开容器内 TLS。
ECHO_HEALTH_SCHEME=http

# ---------------------------------------------------------------------------
# [容器] 服务端运行时配置
# ---------------------------------------------------------------------------
# 这台机器的名字，会出现在 /v1/health 与客户端那边的"这台后端叫什么"。
ECHO_SERVER_ID=gpu-old-01

# ⚠️ **必填**。生成一条即可（64 个十六进制字符）：
#       openssl rand -hex 32
#    （没有 openssl 的话：python3 -c "import secrets;print(secrets.token_hex(32))"）
# 留空的话 `docker compose up` 会**直接报错退出**（这是故意的：宁可起不来，
# 也不要静默起一个谁都能用的服务）。生成之后**别改** —— 换了它所有客户端立刻 401。
ECHO_JWT_SECRET=

# 容器里的路径与并发（一般不用改；改 ECHO_MODELS_ROOT 要同时改上面的宿主路径）
ECHO_MODELS_ROOT=/opt/echo/models
ECHO_TMP_ROOT=/var/echo/tmp
ECHO_STATE_ROOT=/var/echo/state

# 总通道数（出厂 6；每客户端另限 1）。**按卡校准**：老卡算力弱，8 GB 卡上 6 路长音频
# 会互相挤显存。⚠️ 这里是**"空 state 卷首启"时的起点**：管理员在管理面「性能」页签的
# 「运行参数」里改过之后，**管理面那份优先**（存在 state 卷，重启还在）、**改完即时生效**；
# 调并发**优先在管理面调**，不用改这里、也不用重启。
# 要自己压测：同时按你打算填的通道数打满时，单段耗时相对 1 路涨得少 = 还有余量。
ECHO_MAX_CONCURRENT=6

# ###########################################################################
# ⚠️⚠️ **对外公布地址** —— 同事第一次用最容易踩的就是这里，请读完这几行再填。
# ###########################################################################
# 发配对码时，`echo://pair?host=…` 里那个 host 写什么。
#
# **留空 = 自动探测**，而在容器里探测到的是 **Docker 网桥地址**（实测 172.18.0.2）——
# 你发出去的串就是 `echo://pair?host=http://172.18.0.2:8900&code=…`，
# **同事照它连必然连不上**，而且看不出是地址的错。所以：**这台后端要给同事用，就填**。
#
# 填成**同事/客户端能访问到的那个地址**（可直接照抄，把 IP 换成你这台的）：
#     ECHO_ADVERTISED_HOST=10.100.0.24
# 端口不写就用 ECHO_LISTEN 的 8900；下面三种写法**完全等价**：
#     ECHO_ADVERTISED_HOST=10.100.0.24
#     ECHO_ADVERTISED_HOST=10.100.0.24:8900
#     ECHO_ADVERTISED_HOST=http://10.100.0.24:8900
# （写 `https://…` 不会让服务端改用 https —— scheme 由容器里的 TLS 配置决定，
#   开了 TLS 就自动是 https://；这里只认主机名/IP 与端口。）
#
# ⚠️ 这一项是「**每次发码时想公布的地址**」，不是一次性全局常量：
#   * **共享形态**（本包默认：`ECHO_LISTEN=0.0.0.0:8900`，同事要连）→ 填**局域网 IP**；
#   * **只服务本机**（后端与客户端同一台机器）→ **不需要它**：把 compose 里的
#     ECHO_LISTEN 改成 `127.0.0.1:8900`、端口发布也改成 `127.0.0.1:8900:8900`，
#     配对走本机那份 `local-pair.json`，地址天生是 127.0.0.1（而且局域网里根本
#     连不到这个端口，不靠鉴权去挡）。这一档**别**在这里填局域网 IP：本机客户端
#     该走回环，换网络、IP 变了都不受影响。
#   * 同一台后端两边都服务 → 发码时**各写各的**：本机用 127.0.0.1、远程用局域网 IP
#     （管理面「客户端 / 发授权」页签那张卡上，每一张码可以单独填一个地址）。
#
# 也可以不改这里，直接在**管理面**里配（「客户端 / 发授权」页签 →「对外公布地址」卡，
# 保存后立刻生效、存在 state 卷、重启还在）。
# 优先级：**管理面配置 > 这个环境变量 > 自动探测**。
ECHO_ADVERTISED_HOST=

# 鉴权：**保持打开**。关掉 = 任何能连到 8900 的人都能用这块 GPU。
# 前两项与 ECHO_JWT_SECRET 是一组，要么一起配好，要么都别开。
ECHO_AUTH_ENABLED=true
ECHO_AUTH_MODE=jwt
