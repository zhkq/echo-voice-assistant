<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!--
      补传（把手机里的会议音频往 ECHO 传）在 `MeetingMicService` 里跑成**前台服务**，
      类型是 `dataSync`（不是录音）。Android 14 起每个用到的类型都要对应的权限，
      少了这条，`startForeground(..., DATA_SYNC)` 会直接抛 SecurityException。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!--
      锁屏期间不许系统把 CPU/WiFi 降下去的许可（用户 2026-10-19 深夜："锁屏后……要按一下重试"）：
        · WAKE_LOCK  → PARTIAL_WAKE_LOCK（带超时）+ WifiLock 都要求它；
        · ACCESS_WIFI_STATE → 取 WifiManager 建 WiFi 锁（普通权限）。
      ⚠️ 两者都只在**补传进行中**持有，而且都有超时（见 `SyncForeground` 的说明）。
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 「设置 → 权限与省电」里的电池优化白名单：后台听写最怕被系统省电杀掉 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      Android 11+ 的「包可见性」坑：不声明这些，App 会**看不到**系统里的东西，
      而症状全都长得像"这台设备没装"：
        · TTS_SERVICE          → TextToSpeech 找引擎（否则报"没有朗读引擎"）
        · RecognitionService   → SpeechRecognizer.isRecognitionAvailable() 与列服务
        · action.RECOGNIZE_SPEECH → **识别界面那个 Activity**。
          它和上面那条是**两回事**：服务归服务、界面归界面。
          只声明服务那一条时，isRecognitionAvailable() 会正常返回 true，
          但拉起系统识别界面会抛 ActivityNotFoundException
          （2026-10-09 用户真机上就是这个症状 —— 漏的正是这一条）。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:name=".EchoContactApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.EchoContact"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        tools:targetApi="34">

        <!-- singleTop：通知点进来是"派一份新 intent 给已在跑的 Activity"（onNewIntent），
             而不是再叠一个新实例 —— 没有它时，"App 就在最前 + 点通知"会在返回栈里多一层
             （会议照样打开，但返回要多按一次）。MainActivity 的 onNewIntent 就是为这条路写的。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.EchoContact">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.ListenService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- 手机当麦克风：会议录音在手机侧采集、按段传给电脑（用户 2026-10-15 的口径）。
             类型是**两个**，因为同一个服务有两条前台路径，按路径切：
               · 录音 → microphone（老行为）
               · 补传 → dataSync（Android 14 要求类型与真正在干的事对得上）
               · 录音中顺手补传 → microphone|dataSync
             见 `SyncForegroundAndroid` 的说明（为什么不做成两个服务）。 -->
        <service
            android:name=".service.MeetingMicService"
            android:exported="false"
            android:foregroundServiceType="microphone|dataSync" />
    </application>

</manifest>
