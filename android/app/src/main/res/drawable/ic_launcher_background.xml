<?xml version="1.0" encoding="utf-8"?>
<!--
  启动图标的**背景层**：蓝色渐变，铺满整个 108×108。
  色值与方向照 `web/rail.html` 的 `.logo`：linear-gradient(160deg, #4f8cff 0%, #3a6fe0 100%)。
  形状（圆角/圆形/方形）由启动器自己套遮罩，所以这里**画满、不画圆角**。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="14"
                android:startY="4"
                android:endX="94"
                android:endY="104"
                android:startColor="#FF4F8CFF"
                android:endColor="#FF3A6FE0" />
        </aapt:attr>
    </path>
</vector>
